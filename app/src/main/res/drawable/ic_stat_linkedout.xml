<?xml version="1.0" encoding="utf-8"?>
<!--
    Status bar icon for notifications. Android draws it as a white mask, so
    only the shape and its opacity matter. Same glyph as the launcher, without
    the adaptive safe zone scaling: the bounds already sit at 43..468 of 512
    on both axes about the centre, which is the padding a status bar icon
    wants.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="512"
    android:viewportHeight="512">
    <path
        android:pathData="M60,279 a56,56 0 1,0 112,0 a56,56 0 1,0 -112,0"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="34"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
    <path
        android:pathData="M224,223 V286 A49,49 0 0,0 322,286 V223"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="34"
