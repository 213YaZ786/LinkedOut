<?xml version="1.0" encoding="utf-8"?>
<!-- LinkedOut's launcher glyph: "out" in glossy bubble letters.
     A grey body, lit as a round tube, multiplied by a light tone of the
     wallpaper's accent, then the white highlights over it, untinted. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <bitmap
            android:src="@drawable/lo_body"
            android:tint="@color/ic_launcher_letters"
            android:tintMode="multiply" />
    </item>
    <item android:drawable="@drawable/lo_shine" />
</layer-list>
