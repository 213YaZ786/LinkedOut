<?xml version="1.0" encoding="utf-8"?>
<!--
    The themed icon layer. Android 13 and later hand this to the launcher,
    draw their own background from the wallpaper and tint these strokes to
    match, which is the Material You look. The colour below is therefore
    replaced at draw time: only the shape and its opacity matter.

    Same glyph and same 0.73 scale as the foreground, deliberately. That scale
    puts the far edge of the "o" at the very rim of the 66 of 108 safe circle,
    so a round or a themed mask clips nothing.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="512"
    android:viewportHeight="512">

    <group
        android:pivotX="256"
        android:pivotY="256"
        android:scaleX="0.73"
        android:scaleY="0.73">

        <path
            android:pathData="M60,279 a56,56 0 1,0 112,0 a56,56 0 1,0 -112,0"
            android:strokeColor="#FFFFFF"
            android:strokeWidth="34"
            android:strokeLineCap="round"
            android:strokeLineJoin="round" />
        <path
            android:pathData="M224,223 V286 A49,49 0 0,0 322,286 V223"
            android:strokeColor="#FFFFFF"
            android:strokeWidth="34"
            android:strokeLineCap="round"
            android:strokeLineJoin="round" />
        <path
            android:pathData="M414,177 V298 A37,37 0 0,0 451,335"
            android:strokeColor="#FFFFFF"
            android:strokeWidth="34"
            android:strokeLineCap="round"
            android:strokeLineJoin="round" />
        <path
            android:pathData="M378,223 H448"
            android:strokeColor="#FFFFFF"
            android:strokeWidth="34"
            android:strokeLineCap="round"
            android:strokeLineJoin="round" />
    </group>
</vector>
