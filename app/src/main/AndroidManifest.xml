<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!--
        Asked for at the moment the reader turns on notifications for new
        posts, or automatic media downloads, and never before.
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!--
        Required to hand DownloadManager a request with its own notification
        turned off. Without it every enqueue throws a SecurityException, which
        is what silently refused every automatic media download in 0.6.30.
        Granted at install, it asks the reader nothing.
    -->
    <uses-permission android:name="android.permission.DOWNLOAD_WITHOUT_NOTIFICATION" />

    <application
        android:name=".LinkedOutApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.LinkedOut"
        android:enableOnBackInvokedCallback="true"
        android:usesCleartextTraffic="false">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|uiMode"
            android:windowSoftInputMode="adjustResize"
            android:launchMode="singleTask"
            android:theme="@style/Theme.LinkedOut">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
                LinkedIn links. Not autoVerify: only LinkedIn can prove it owns
                linkedin.com, so Android lists these as unverified. They open in
                LinkedOut once the reader enables them under Open by default,
                which Settings links to. Paths are not filtered here, LinkRouter
                decides and hands anything it cannot show to the browser.

                "*.linkedin.com" matches every country subdomain, fr, uk, de and
                the rest, but not the bare domain, so linkedin.com is listed on
                its own line. lnkd.in is LinkedIn's own shortener. This is the
                same host set LinkedInLink.isLinkedInHost accepts.
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <data android:scheme="http" />
                <data android:host="linkedin.com" />
                <data android:host="*.linkedin.com" />
                <data android:host="lnkd.in" />
            </intent-filter>

            <!-- Share a link to LinkedOut from any app, no setup needed. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>
    </application>
</manifest>
